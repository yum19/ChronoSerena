# ============================================================
# 1. SECRETS - never commit these
# ============================================================

# Environment files (DB creds, SMTP password, Twilio, Stripe, APP_SECRET)
.env
.env.local
.env.*.local
.env.dev
**/.env
**/.env.local
**/.env.*.local
**/.env.dev
!**/.env.example
!**/.env.test

# Java config holding Twilio / DB credentials
**/application.properties
!**/application.properties.example

# Symfony decrypted prod secrets
**/config/secrets/prod/prod.decrypt.private.php

# Private keys / certificates
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
*.ppk


